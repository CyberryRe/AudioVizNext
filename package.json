{
  "name": "audioviznext",
  "version": "0.1.0",
  "description": "AudioVizNext — 专业音频可视化工具（Electron + Vite + WebGL）",
  "main": "./out/main/index.js",
  "author": "CyberryRe",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
        "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:model": "node --experimental-strip-types test/model.test.mjs",
    "test:avnpre": "node --experimental-strip-types test/avnpre.test.mjs",
    "test:keyframes": "node --experimental-strip-types test/keyframes.test.mjs",
    "test:audio": "node --experimental-strip-types test/audioAlgorithms.test.mjs",
    "test:layer3d": "node --experimental-strip-types test/layer3d.test.mjs",
    "test:presets": "node --experimental-strip-types --import ./test/registerTsResolve.mjs test/radialBars.test.mjs",
    "test:gif": "node --experimental-strip-types test/gif.test.mjs && node --experimental-strip-types test/gif-synth.test.mjs",
    "test": "npm run test:model && npm run test:avnpre && npm run test:keyframes && npm run test:audio && npm run test:layer3d && npm run test:presets && npm run test:gif"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "mediabunny": "^1.55.7",
    "pixi.js": "^8.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
