{
  "format": "avnpre",
  "version": 1,
  "createdBy": "AudioVizNext-demo",
  "createdAt": "2026-09-10T09:37:47.240Z",
  "preset": {
    "format": "avnpreset",
    "version": 1,
    "id": "radial-bars",
    "name": "环形频谱柱",
    "category": "visualization",
    "clipType": "visual",
    "kind": "visual",
    "drawer": "radial-bars",
    "durationFrames": 300,
    "color": "#e76f51",
    "desc": "圆形柱状频谱：柱体自中心向外辐射。开启「跟随圆形图片」后自动对齐同帧圆形预设。",
    "params": [
      {
        "key": "followCircle",
        "label": "跟随圆形图片",
        "type": "bool",
        "group": "跟随",
        "default": true
      },
      {
        "key": "ringPad",
        "label": "相对环距",
        "type": "number",
        "group": "跟随",
        "min": 0,
        "max": 0.5,
        "step": 0.01,
        "default": 0.08,
        "percent": true
      },
      {
        "key": "posX",
        "label": "位置 X",
        "type": "number",
        "group": "布局",
        "min": -0.5,
        "max": 0.5,
        "step": 0.005,
        "default": 0,
        "percent": true
      },
      {
        "key": "posY",
        "label": "位置 Y",
        "type": "number",
        "group": "布局",
        "min": -0.5,
        "max": 0.5,
        "step": 0.005,
        "default": 0,
        "percent": true
      },
      {
        "key": "baseRadius",
        "label": "基础半径",
        "type": "number",
        "group": "布局",
        "min": 20,
        "max": 800,
        "step": 1,
        "default": 180,
        "unit": "px"
      },
      {
        "key": "barCount",
        "label": "柱数量",
        "type": "number",
        "group": "柱体",
        "min": 16,
        "max": 180,
        "step": 1,
        "default": 64,
        "keyframe": true
      },
      {
        "key": "barWidth",
        "label": "柱宽",
        "type": "number",
        "group": "柱体",
        "min": 0.2,
        "max": 1,
        "step": 0.05,
        "default": 0.55,
        "percent": true
      },
      {
        "key": "barLength",
        "label": "柱长",
        "type": "number",
        "group": "柱体",
        "min": 0.02,
        "max": 0.5,
        "step": 0.005,
        "default": 0.12,
        "percent": true,
        "keyframe": true
      },
      {
        "key": "minLen",
        "label": "最小柱长",
        "type": "number",
        "group": "柱体",
        "min": 0,
        "max": 0.08,
        "step": 0.002,
        "default": 0.01,
        "percent": true
      },
      {
        "key": "gamma",
        "label": "频谱增益",
        "type": "number",
        "group": "柱体",
        "min": 0.4,
        "max": 3,
        "step": 0.05,
        "default": 1.3
      },
      {
        "key": "spin",
        "label": "整体转速",
        "type": "number",
        "group": "动画",
        "min": -1,
        "max": 1,
        "step": 0.01,
        "default": 0,
        "unit": "圈/秒"
      },
      {
        "key": "colorA",
        "label": "颜色 A",
        "type": "color",
        "group": "颜色",
        "default": "#ff6b6b"
      },
      {
        "key": "colorB",
        "label": "颜色 B",
        "type": "color",
        "group": "颜色",
        "default": "#ffd93d"
      },
      {
        "key": "glow",
        "label": "辉光",
        "type": "number",
        "group": "颜色",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 0.4,
        "percent": true
      },
      {
        "key": "innerRing",
        "label": "内圈描边",
        "type": "bool",
        "group": "颜色",
        "default": true
      }
    ],
    "implementation": {
      "type": "script",
      "language": "js",
      "source": "const tRel = env.tRel || 0\nconst followOn = params.followCircle !== false\nconst follow = followOn ? env.followCircle : null\nconst pad = api.paramAt(params, env.keyframes, 'ringPad', tRel, 0.08)\nconst px = api.paramAt(params, env.keyframes, 'posX', tRel, 0)\nconst py = api.paramAt(params, env.keyframes, 'posY', tRel, 0)\nconst baseR = api.paramAt(params, env.keyframes, 'baseRadius', tRel, 180)\nconst n = Math.max(8, Math.round(api.paramAt(params, env.keyframes, 'barCount', tRel, 64)))\nconst barW = api.paramAt(params, env.keyframes, 'barWidth', tRel, 0.55)\nconst barLen = api.paramAt(params, env.keyframes, 'barLength', tRel, 0.12)\nconst minLen = api.paramAt(params, env.keyframes, 'minLen', tRel, 0.01)\nconst gamma = api.paramAt(params, env.keyframes, 'gamma', tRel, 1.3)\nconst spin = api.paramAt(params, env.keyframes, 'spin', tRel, 0)\nconst glow = api.paramAt(params, env.keyframes, 'glow', tRel, 0.4)\nconst colorA = params.colorA || '#ff6b6b'\nconst colorB = params.colorB || '#ffd93d'\nconst W = env.width\nconst H = env.height\nconst cx = follow ? follow.x : W / 2 + px * W\nconst cy = follow ? follow.y : H / 2 + py * H\nconst r0 = follow ? follow.radius * (1 + pad) : baseR\nconst lenScale = follow ? follow.radius : Math.min(W, H) * 0.35\nconst maxExtra = lenScale * barLen * 3 + H * barLen * 0.5\nconst minExtra = Math.max(2, lenScale * minLen)\nconst rot = spin * Math.PI * 2 * env.timeSec + (follow ? follow.spinRad * 0.15 : 0)\nctx.save()\nctx.globalAlpha = env.opacity\nctx.translate(cx, cy)\nctx.rotate(rot)\nif (params.innerRing !== false) {\n  ctx.beginPath()\n  ctx.arc(0, 0, r0, 0, Math.PI * 2)\n  ctx.strokeStyle = api.mixColor(colorA, '#ffffff', 0.15)\n  ctx.globalAlpha = env.opacity * 0.55\n  ctx.lineWidth = 2\n  ctx.stroke()\n  ctx.globalAlpha = env.opacity\n}\nconst step = (Math.PI * 2) / n\nconst half = step * barW * 0.5\nfor (let i = 0; i < n; i++) {\n  const v = api.freqValue(env.audio, env.frame, i, n, gamma)\n  const len = Math.max(minExtra, v * maxExtra)\n  const a = i * step - Math.PI / 2\n  const mix = n <= 1 ? 0 : i / (n - 1)\n  const col = api.mixColor(colorA, colorB, mix)\n  if (glow > 0.01) { ctx.shadowColor = col; ctx.shadowBlur = 12 * glow }\n  ctx.fillStyle = col\n  const x0 = Math.cos(a - half) * r0\n  const y0 = Math.sin(a - half) * r0\n  const x1 = Math.cos(a - half) * (r0 + len)\n  const y1 = Math.sin(a - half) * (r0 + len)\n  const x2 = Math.cos(a + half) * (r0 + len)\n  const y2 = Math.sin(a + half) * (r0 + len)\n  const x3 = Math.cos(a + half) * r0\n  const y3 = Math.sin(a + half) * r0\n  ctx.beginPath()\n  ctx.moveTo(x0, y0)\n  ctx.lineTo(x1, y1)\n  ctx.lineTo(x2, y2)\n  ctx.lineTo(x3, y3)\n  ctx.closePath()\n  ctx.fill()\n  ctx.shadowBlur = 0\n}\nctx.restore()"
    }
  }
}