{
  "format": "avnpreset",
  "version": 1,
  "id": "rounded-rect",
  "name": "圆角矩形",
  "category": "image",
  "clipType": "image",
  "kind": "image",
  "drawer": "image-shape",
  "durationFrames": 150,
  "color": "#7a4a9a",
  "desc": "把绑定的图片裁成圆角矩形，可调圆角、位置与缩放。",
  "params": [
    { "key": "shape", "label": "形状", "type": "select", "group": "形状", "options": [{ "value": "rounded-rect", "label": "圆角矩形" }], "default": "rounded-rect" },
    { "key": "radius", "label": "圆角大小", "type": "number", "group": "形状", "min": 0, "max": 0.5, "step": 0.005, "default": 0.08, "percent": true },
    { "key": "posX", "label": "位置 X", "type": "number", "group": "布局", "min": -0.5, "max": 0.5, "step": 0.005, "default": 0, "percent": true },
    { "key": "posY", "label": "位置 Y", "type": "number", "group": "布局", "min": -0.5, "max": 0.5, "step": 0.005, "default": 0, "percent": true },
    { "key": "scaleX", "label": "缩放 X", "type": "number", "group": "布局", "min": 0.1, "max": 4, "step": 0.01, "default": 1 },
    { "key": "scaleY", "label": "缩放 Y", "type": "number", "group": "布局", "min": 0.1, "max": 4, "step": 0.01, "default": 1, "link": "scaleX" },
    { "key": "border", "label": "边框宽度", "type": "number", "group": "描边", "min": 0, "max": 0.05, "step": 0.001, "default": 0, "percent": true },
    { "key": "borderColor", "label": "边框颜色", "type": "color", "group": "描边", "default": "#ffffff" }
  ]
}
