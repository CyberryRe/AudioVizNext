{
  "format": "avnpreset",
  "version": 1,
  "id": "radial-bars",
  "name": "环形频谱柱",
  "category": "visualization",
  "clipType": "visual",
  "kind": "visual",
  "drawer": "radial-bars",
  "durationFrames": 300,
  "color": "#e76f51",
  "desc": "圆形柱状频谱：柱体自中心向外辐射，柱样式可选尖角/圆角/胶囊。开启「跟随圆形图片」后与同帧圆形预设严格同面（圆形贴了 3D 面也一样逐点跟随）。",
  "params": [
    { "key": "followCircle", "label": "跟随圆形图片", "type": "bool", "group": "跟随", "default": true },
    { "key": "ringPad", "label": "相对环距", "type": "number", "group": "跟随", "min": 0, "max": 0.5, "step": 0.01, "default": 0.08, "percent": true },
    { "key": "posX", "label": "位置 X", "type": "number", "group": "布局", "min": -0.5, "max": 0.5, "step": 0.005, "default": 0, "percent": true },
    { "key": "posY", "label": "位置 Y", "type": "number", "group": "布局", "min": -0.5, "max": 0.5, "step": 0.005, "default": 0, "percent": true },
    { "key": "baseRadius", "label": "基础半径", "type": "number", "group": "布局", "min": 20, "max": 800, "step": 1, "default": 180, "unit": "px" },
    {
      "key": "barStyle",
      "label": "柱样式",
      "type": "select",
      "group": "柱体",
      "options": [
        { "value": "sharp", "label": "尖角（原样）" },
        { "value": "round", "label": "圆角" },
        { "value": "pill", "label": "胶囊" }
      ],
      "default": "round",
      "hint": "圆角半径按柱长/柱宽自适应，短柱与窄柱都不会被圆角吃掉"
    },
    { "key": "barCount", "label": "柱数量", "type": "number", "group": "柱体", "min": 16, "max": 180, "step": 1, "default": 64, "keyframe": true },
    { "key": "barWidth", "label": "柱宽", "type": "number", "group": "柱体", "min": 0.2, "max": 1, "step": 0.05, "default": 0.55, "percent": true },
    { "key": "barLength", "label": "柱长", "type": "number", "group": "柱体", "min": 0.02, "max": 0.5, "step": 0.005, "default": 0.12, "percent": true, "keyframe": true },
    { "key": "minLen", "label": "最小柱长", "type": "number", "group": "柱体", "min": 0, "max": 0.08, "step": 0.002, "default": 0.01, "percent": true },
    { "key": "gamma", "label": "频谱增益", "type": "number", "group": "柱体", "min": 0.4, "max": 3, "step": 0.05, "default": 1.3 },
    { "key": "spin", "label": "整体转速", "type": "number", "group": "动画", "min": -1, "max": 1, "step": 0.01, "default": 0, "unit": "圈/秒" },
    { "key": "colorA", "label": "颜色 A", "type": "color", "group": "颜色", "default": "#ff6b6b" },
    { "key": "colorB", "label": "颜色 B", "type": "color", "group": "颜色", "default": "#ffd93d" },
    { "key": "glow", "label": "辉光", "type": "number", "group": "颜色", "min": 0, "max": 1, "step": 0.05, "default": 0.4, "percent": true },
    { "key": "innerRing", "label": "内圈描边", "type": "bool", "group": "颜色", "default": true }
  ]
}
